  "normalize_guid": {
    "parity": [
      {
        "input": "https://blog.naver.com/abc/123?fromRss=true&trackingCode=rss",
        "expected": "https://blog.naver.com/abc/123"
      },
      {
        "input": "https://blog.naver.com/abc/123?fromRss=true&trackingCode=rss&x=1",
        "expected": "https://blog.naver.com/abc/123?x=1"
      },
      {
        "input": "https://example.com/p?a=1&a=2",
        "expected": "https://example.com/p?a=1"
      },
      {
        "input": "https://example.com/p?q=hello world&z=%EA%B0%80",
        "expected": "https://example.com/p?q=hello+world&z=%EA%B0%80"
      },
      {
        "input": "https://gizmodo.com/?p=123",
        "expected": "https://gizmodo.com/?p=123"
      },
      {
        "input": "tag:example.com,2026:post-1",
        "expected": "tag:example.com,2026:post-1"
      },
      {
        "input": "urn:uuid:1225c695-cfb8-4ebb-aaaa-80da344efa6a",
        "expected": "urn:uuid:1225c695-cfb8-4ebb-aaaa-80da344efa6a"
      },
      {
        "input": "https://example.com/post#frag",
        "expected": "https://example.com/post#frag"
      },
      {
        "input": "https://example.com/p?empty=&k=v",
        "expected": "https://example.com/p?empty=&k=v"
      },
      {
        "input": "",
        "expected": ""
      },
      {
        "input": null,
        "expected": null
      }
    ],
    "idempotent_for_all_inputs": true
  },
